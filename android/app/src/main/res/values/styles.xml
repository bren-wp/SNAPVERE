<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/snapvere_canvas</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/snapvere_accent</item>
        <item name="android:colorControlHighlight">@color/snapvere_ripple</item>
        <item name="android:navigationBarColor">@color/snapvere_canvas</item>
        <item name="android:statusBarColor">@color/snapvere_canvas</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
