<Window
    x:Class="Snapvere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SNAPVERE">

    <Grid Background="#0B0D12">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Grid.Row="0"
            Padding="18,0,148,0"
            Background="#0B0D12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="28"
                Height="28"
                CornerRadius="8"
                Background="#7C6CFF"
                VerticalAlignment="Center">
                <TextBlock
                    Text="S"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <TextBlock
                Grid.Column="1"
                Margin="10,0,0,0"
                Text="SNAPVERE"
                Foreground="White"
                FontSize="13"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

            <Border
                Grid.Column="2"
                Padding="10,4"
                CornerRadius="10"
                Background="#202633"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="VersionText"
                    Text="v0.0.2"
                    Foreground="#D8DCE5"
                    FontSize="11"
                    FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="#12151C"
                BorderBrush="#2A3140"
                BorderThickness="0,1,1,0"
                Padding="16,22,16,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="CAPTURE"
                            Foreground="#98A2B3"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="8,0,0,4" />

                        <Border
                            Padding="12,10"
                            CornerRadius="10"
                            Background="#262142">
                            <TextBlock
                                Text="Capture center"
                                Foreground="White"
                                FontWeight="SemiBold" />
                        </Border>

                        <TextBlock
                            Text="Region  ·  Ctrl + Shift + 1"
                            Foreground="#98A2B3"
                            FontSize="12"
                            Margin="10,4,0,0" />
                        <TextBlock
                            Text="Screen  ·  Ctrl + Shift + 4"
                            Foreground="#98A2B3"
                            FontSize="12"
                            Margin="10,0,0,0" />
                    </StackPanel>

                    <Border
                        Grid.Row="2"
                        Padding="12"
                        CornerRadius="12"
                        Background="#181C25"
                        BorderBrush="#2A3140"
                        BorderThickness="1">
                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Local-first"
                                Foreground="White"
                                FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="No account, telemetry, or cloud upload is required for capture."
                                Foreground="#98A2B3"
                                FontSize="11"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Column="1"
                VerticalScrollBarVisibility="Auto">
                <Grid
                    Padding="34,28,34,34"
                    MaxWidth="1080"
                    HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Capture center"
                                Foreground="White"
                                FontSize="32"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Fast capture, precise selection, local PNG output."
                                Foreground="#98A2B3"
                                FontSize="15" />
                        </StackPanel>

                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OpenCaptureFolderButton_Click"
                            Content="Open folder" />
                    </Grid>

                    <InfoBar
                        x:Name="CaptureStatus"
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        IsOpen="False"
                        IsClosable="True" />

                    <Grid
                        Grid.Row="2"
                        Margin="0,24,0,0"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            MinHeight="260"
                            Padding="26"
                            CornerRadius="18"
                            Background="#302A63"
                            BorderBrush="#5749C9"
                            BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Border
                                        Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="#463F78"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            Text="R"
                                            Foreground="White"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <Border
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Padding="9,5"
                                        CornerRadius="8"
                                        Background="#423B69">
                                        <TextBlock
                                            Text="Ctrl + Shift + 1"
                                            Foreground="White"
                                            FontSize="11" />
                                    </Border>
                                </Grid>

                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,22,0,20"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="Capture a precise region"
                                        Foreground="White"
                                        FontSize="24"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Freeze the display, drag an exact area, fine-tune the selection, then save it locally as PNG."
                                        Foreground="#D8D6F2"
                                        FontSize="13"
                                        TextWrapping="Wrap"
                                        MaxWidth="560" />
                                </StackPanel>

                                <Button
                                    x:Name="RegionCaptureButton"
                                    Grid.Row="2"
                                    Click="RegionCaptureButton_Click"
                                    HorizontalAlignment="Left"
                                    Padding="18,10"
                                    Content="Select region" />
                            </Grid>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="14">
                            <Border
                                Padding="22"
                                CornerRadius="18"
                                Background="#181C25"
                                BorderBrush="#2A3140"
                                BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <Border
                                            Width="40"
                                            Height="40"
                                            CornerRadius="11"
                                            Background="#262142"
                                            HorizontalAlignment="Left">
                                            <TextBlock
                                                Text="S"
                                                Foreground="#A89EFF"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <Border
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="8,4"
                                            CornerRadius="7"
                                            Background="#202633">
                                            <TextBlock
                                                Text="Ctrl + Shift + 4"
                                                Foreground="#98A2B3"
                                                FontSize="10" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            Text="Full screen"
                                            Foreground="White"
                                            FontSize="19"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Capture the primary display directly to Pictures\SNAPVERE."
                                            Foreground="#98A2B3"
                                            FontSize="12"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button
                                        x:Name="ScreenCaptureButton"
                                        Click="ScreenCaptureButton_Click"
                                        HorizontalAlignment="Stretch"
                                        Padding="12,9"
                                        Content="Capture screen" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="18"
                                CornerRadius="18"
                                Background="#181C25"
                                BorderBrush="#2A3140"
                                BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Text="Private by default"
                                        Foreground="White"
                                        FontSize="13"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Captures stay on this PC. SNAPVERE does not require an account or telemetry connection."
                                        Foreground="#98A2B3"
                                        FontSize="11"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Row="3"
                        Margin="0,30,0,0"
                        Spacing="12">
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock
                                    Text="Recent captures"
                                    Foreground="White"
                                    FontSize="21"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="RecentCapturesCountText"
                                    Text="Local screenshots from Pictures\SNAPVERE"
                                    Foreground="#98A2B3"
                                    FontSize="12" />
                            </StackPanel>

                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="RefreshHistoryButton_Click"
                                Content="Refresh" />
                        </Grid>

                        <ListView
                            x:Name="RecentCapturesList"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="RecentCapturesList_ItemClick"
                            MaxHeight="330"
                            Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                Text="{Binding FileName}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding MetadataText}"
                                                Foreground="#98A2B3"
                                                FontSize="11" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Text="Open"
                                            Foreground="#98A2B3"
                                            FontSize="11"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border
                            x:Name="HistoryEmptyState"
                            Padding="24"
                            CornerRadius="16"
                            Background="#181C25"
                            BorderBrush="#2A3140"
                            BorderThickness="1">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Spacing="7">
                                <TextBlock
                                    x:Name="HistoryEmptyTitle"
                                    Text="No local captures yet"
                                    Foreground="White"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    x:Name="HistoryEmptyMessage"
                                    Text="Your completed Region and Screen captures will appear here."
                                    Foreground="#98A2B3"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    MaxWidth="460" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
