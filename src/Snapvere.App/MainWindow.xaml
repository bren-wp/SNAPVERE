<Window
    x:Class="Snapvere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SNAPVERE">
  <Grid>
    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="RootNavigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Capture" Tag="capture">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Camera" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="History" Tag="history">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Clock" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Editor" Tag="editor">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Edit" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <ScrollViewer>
        <Grid Padding="36,28" MaxWidth="1060" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="6">
            <TextBlock Text="SNAPVERE" FontSize="13" FontWeight="SemiBold" Opacity="0.72" />
            <TextBlock Text="Capture anything." FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Fast, precise screen capture for Windows." FontSize="15" Opacity="0.72" />
          </StackPanel>

          <InfoBar
              x:Name="CaptureStatus"
              Grid.Row="1"
              Margin="0,20,0,0"
              IsOpen="False"
              IsClosable="True" />

          <Grid Grid.Row="2" Margin="0,28,0,0" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" MinHeight="82" HorizontalAlignment="Stretch" IsEnabled="False" AutomationProperties.Name="Region capture in development">
              <StackPanel Spacing="4">
                <TextBlock Text="Region" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Selection engine ready — overlay in development" Opacity="0.68" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
            <Button Grid.Row="0" Grid.Column="1" MinHeight="82" HorizontalAlignment="Stretch" IsEnabled="False" AutomationProperties.Name="Window capture in development">
              <StackPanel Spacing="4">
                <TextBlock Text="Window" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Window targeting in development" Opacity="0.68" />
              </StackPanel>
            </Button>
            <Button
                x:Name="ScreenCaptureButton"
                Grid.Row="1"
                Grid.Column="0"
                MinHeight="82"
                HorizontalAlignment="Stretch"
                Click="ScreenCaptureButton_Click"
                AutomationProperties.Name="Capture primary screen to Pictures SNAPVERE">
              <StackPanel Spacing="4">
                <TextBlock Text="Screen" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Capture primary display to Pictures\SNAPVERE" Opacity="0.68" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" MinHeight="82" HorizontalAlignment="Stretch" IsEnabled="False" AutomationProperties.Name="Scrolling capture in development">
              <StackPanel Spacing="4">
                <TextBlock Text="Scroll" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Planned — not exposed as a fake feature" Opacity="0.68" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
          </Grid>

          <StackPanel Grid.Row="3" Margin="0,34,0,0" Spacing="10">
            <TextBlock Text="Recent captures" FontSize="20" FontWeight="SemiBold" />
            <Border Padding="24" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <StackPanel HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="History UI not enabled yet." FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Completed screen captures are saved locally. History will appear only after its storage workflow is implemented." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.68" MaxWidth="480" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Window>
