<Window
    x:Class="Snapvere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SNAPVERE">
  <Grid Background="{ThemeResource SnapvereCanvasBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid
        x:Name="TitleBarDragRegion"
        Grid.Row="0"
        Padding="18,0,148,0"
        Background="{ThemeResource SnapvereCanvasBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border
          Width="28"
          Height="28"
          CornerRadius="8"
          Background="{ThemeResource SnapvereAccentBrush}"
          VerticalAlignment="Center">
        <TextBlock
            Text="S"
            FontSize="14"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="White" />
      </Border>

      <TextBlock
          Grid.Column="1"
          Margin="10,0,0,0"
          Text="SNAPVERE"
          FontSize="13"
          FontWeight="SemiBold"
          VerticalAlignment="Center" />

      <Border
          Grid.Column="3"
          Padding="9,4"
          CornerRadius="999"
          Background="{ThemeResource SnapvereSurfaceSoftBrush}"
          BorderBrush="{ThemeResource SnapvereBorderBrush}"
          BorderThickness="1"
          VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Width="6" Height="6" Fill="{ThemeResource SnapvereSuccessBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText" Text="v0.0.2" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border
          Grid.Column="0"
          Background="{ThemeResource SnapvereSurfaceBrush}"
          BorderBrush="{ThemeResource SnapvereBorderBrush}"
          BorderThickness="0,1,1,0"
          Padding="16,22,16,18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="8">
            <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" Margin="10,0,0,4" />
            <Border Padding="12,10" CornerRadius="10" Background="{ThemeResource SnapvereAccentSoftBrush}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE722;" FontSize="15" Foreground="{ThemeResource SnapvereAccentBrush}" />
                <TextBlock Text="Capture" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Padding="12,10" CornerRadius="10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xEB9F;" FontSize="15" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
                <TextBlock Text="Recent" VerticalAlignment="Center" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,30,0,0" Spacing="10">
            <TextBlock Text="COMING NEXT" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" Margin="10,0,0,4" />
            <Grid Padding="10,5">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Window capture" FontSize="12" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Text="Soon" FontSize="10" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
            </Grid>
            <Grid Padding="10,5">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Scrolling" FontSize="12" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Text="Soon" FontSize="10" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
            </Grid>
            <Grid Padding="10,5">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Editor + OCR" FontSize="12" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Text="Soon" FontSize="10" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
            </Grid>
          </StackPanel>

          <Border
              Grid.Row="3"
              Padding="12"
              CornerRadius="12"
              Background="{ThemeResource SnapvereSurfaceRaisedBrush}"
              BorderBrush="{ThemeResource SnapvereBorderBrush}"
              BorderThickness="1">
            <StackPanel Spacing="5">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{ThemeResource SnapvereSuccessBrush}" />
                <TextBlock Text="Local-first" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="No account, telemetry, or cloud upload is required for capture." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <Grid Padding="36,30,36,36" MaxWidth="1120" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <StackPanel Spacing="6">
              <TextBlock Text="Capture center" FontSize="34" FontWeight="SemiBold" />
              <TextBlock Text="Fast capture, precise selection, local PNG output." FontSize="15" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
              <Button Click="OpenCaptureFolderButton_Click" ToolTipService.ToolTip="Open Pictures\SNAPVERE">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Glyph="&#xE838;" FontSize="14" />
                  <TextBlock Text="Open folder" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <InfoBar
              x:Name="CaptureStatus"
              Grid.Row="1"
              Margin="0,20,0,0"
              IsOpen="False"
              IsClosable="True" />

          <Grid Grid.Row="2" Margin="0,24,0,0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.35*" />
              <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                MinHeight="270"
                Padding="28"
                CornerRadius="20"
                BorderBrush="#5749C9"
                BorderThickness="1">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#302A63" Offset="0" />
                  <GradientStop Color="#1B1833" Offset="0.58" />
                  <GradientStop Color="#151821" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                  <Border Width="46" Height="46" CornerRadius="13" Background="#2DFFFFFF" HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xEA86;" FontSize="21" Foreground="White" />
                  </Border>
                  <Border HorizontalAlignment="Right" Padding="9,5" CornerRadius="8" Background="#24FFFFFF">
                    <TextBlock Text="Ctrl + Shift + 1" FontSize="11" Foreground="White" />
                  </Border>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,24,0,20" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Capture a precise region" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                  <TextBlock Text="Freeze the display, drag an exact area, fine-tune the selection with handles or arrow keys, then save locally." FontSize="13" Foreground="#D8D6F2" TextWrapping="Wrap" MaxWidth="560" />
                </StackPanel>

                <Button
                    x:Name="RegionCaptureButton"
                    Grid.Row="2"
                    Click="RegionCaptureButton_Click"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="18,10"
                    AutomationProperties.Name="Capture a region, Ctrl Shift 1">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE722;" FontSize="15" />
                    <TextBlock Text="Select region" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
              <Border
                  Padding="22"
                  CornerRadius="18"
                  Background="{ThemeResource SnapvereSurfaceRaisedBrush}"
                  BorderBrush="{ThemeResource SnapvereBorderBrush}"
                  BorderThickness="1">
                <StackPanel Spacing="14">
                  <Grid>
                    <Border Width="40" Height="40" CornerRadius="11" Background="{ThemeResource SnapvereAccentSoftBrush}" HorizontalAlignment="Left">
                      <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource SnapvereAccentBrush}" />
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,4" CornerRadius="7" Background="{ThemeResource SnapvereSurfaceSoftBrush}">
                      <TextBlock Text="Ctrl + Shift + 4" FontSize="10" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
                    </Border>
                  </Grid>
                  <StackPanel Spacing="5">
                    <TextBlock Text="Full screen" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Capture the primary display directly to Pictures\SNAPVERE." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
                  </StackPanel>
                  <Button
                      x:Name="ScreenCaptureButton"
                      Click="ScreenCaptureButton_Click"
                      HorizontalAlignment="Stretch"
                      Padding="12,9"
                      AutomationProperties.Name="Capture full screen, Ctrl Shift 4">
                    <TextBlock Text="Capture screen" HorizontalAlignment="Center" FontWeight="SemiBold" />
                  </Button>
                </StackPanel>
              </Border>

              <Border
                  Padding="18"
                  CornerRadius="18"
                  Background="{ThemeResource SnapvereSurfaceRaisedBrush}"
                  BorderBrush="{ThemeResource SnapvereBorderBrush}"
                  BorderThickness="1">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource SnapvereSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Private by default" FontSize="13" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Text="Captures stay on this PC. SNAPVERE does not require an account or telemetry connection." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="3" Margin="0,30,0,0" Spacing="12">
            <Grid>
              <StackPanel Spacing="3">
                <TextBlock Text="Recent captures" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="RecentCapturesCountText" Text="Local screenshots from Pictures\SNAPVERE" FontSize="12" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
              </StackPanel>
              <Button
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Click="RefreshHistoryButton_Click"
                  ToolTipService.ToolTip="Refresh recent captures"
                  AutomationProperties.Name="Refresh recent captures">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Glyph="&#xE72C;" FontSize="13" />
                  <TextBlock Text="Refresh" />
                </StackPanel>
              </Button>
            </Grid>

            <ListView
                x:Name="RecentCapturesList"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="RecentCapturesList_ItemClick"
                MaxHeight="330"
                Visibility="Collapsed">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Padding="8,10" MinWidth="480">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="11" Background="{ThemeResource SnapvereAccentSoftBrush}" VerticalAlignment="Center">
                      <FontIcon Glyph="&#xEB9F;" FontSize="17" Foreground="{ThemeResource SnapvereAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding MetadataText}" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="HistoryEmptyState"
                Padding="24"
                CornerRadius="16"
                Background="{ThemeResource SnapvereSurfaceRaisedBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource SnapvereBorderBrush}">
              <StackPanel HorizontalAlignment="Center" Spacing="7">
                <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource SnapvereSurfaceSoftBrush}">
                  <FontIcon Glyph="&#xEB9F;" FontSize="17" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" />
                </Border>
                <TextBlock x:Name="HistoryEmptyTitle" Text="No local captures yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="HistoryEmptyMessage" Text="Your completed Region and Screen captures will appear here." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource SnapvereTextSecondaryBrush}" MaxWidth="460" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
