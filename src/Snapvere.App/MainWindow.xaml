<Window
    x:Class="Snapvere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SNAPVERE">
  <Grid>
    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="RootNavigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Capture" Tag="capture">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Camera" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="History" Tag="history">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Clock" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Editor" Tag="editor">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Edit" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <ScrollViewer>
        <Grid Padding="36,28" MaxWidth="1060" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="6">
            <TextBlock Text="SNAPVERE" FontSize="13" FontWeight="SemiBold" Opacity="0.72" />
            <TextBlock Text="Capture anything." FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Fast, precise screen capture for Windows." FontSize="15" Opacity="0.72" />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,28,0,0" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" MinHeight="82" HorizontalAlignment="Stretch" AutomationProperties.Name="Capture region">
              <StackPanel Spacing="4">
                <TextBlock Text="Region" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Select a precise area" Opacity="0.68" />
              </StackPanel>
            </Button>
            <Button Grid.Row="0" Grid.Column="1" MinHeight="82" HorizontalAlignment="Stretch" AutomationProperties.Name="Capture window">
              <StackPanel Spacing="4">
                <TextBlock Text="Window" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Capture an application window" Opacity="0.68" />
              </StackPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="0" MinHeight="82" HorizontalAlignment="Stretch" AutomationProperties.Name="Capture screen">
              <StackPanel Spacing="4">
                <TextBlock Text="Screen" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Capture the active display" Opacity="0.68" />
              </StackPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" MinHeight="82" HorizontalAlignment="Stretch" IsEnabled="False" AutomationProperties.Name="Scrolling capture planned">
              <StackPanel Spacing="4">
                <TextBlock Text="Scroll" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Planned — not exposed as a fake feature" Opacity="0.68" />
              </StackPanel>
            </Button>
          </Grid>

          <StackPanel Grid.Row="2" Margin="0,34,0,0" Spacing="10">
            <TextBlock Text="Recent captures" FontSize="20" FontWeight="SemiBold" />
            <Border Padding="24" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <StackPanel HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="No captures yet." FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Press Print Screen or choose a capture mode to create your first screenshot." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.68" MaxWidth="420" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Window>
