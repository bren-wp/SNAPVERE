<Window
    x:Class="Snapvere.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SNAPVERE">
  <Grid>
    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="RootNavigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Capture" Tag="capture">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Camera" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="History" Tag="history" IsEnabled="False" AutomationProperties.Name="Full history coming after version 0.0.1">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Clock" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Editor" Tag="editor" IsEnabled="False" AutomationProperties.Name="Editor coming after version 0.0.1">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Edit" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <ScrollViewer>
        <Grid Padding="36,28,36,34" MaxWidth="1080" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <StackPanel Spacing="6">
              <TextBlock Text="SNAPVERE" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SnapvereAccentBrush}" />
              <TextBlock Text="Capture anything." FontSize="34" FontWeight="SemiBold" />
              <TextBlock Text="Precise, local-first screen capture for Windows." FontSize="15" Opacity="0.72" />
            </StackPanel>

            <Border
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="12,7"
                CornerRadius="999"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="VersionText" Text="v0.0.1" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="Local only" FontSize="12" Opacity="0.68" />
              </StackPanel>
            </Border>
          </Grid>

          <InfoBar
              x:Name="CaptureStatus"
              Grid.Row="1"
              Margin="0,20,0,0"
              IsOpen="False"
              IsClosable="True" />

          <Grid Grid.Row="2" Margin="0,28,0,0" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                x:Name="RegionCaptureButton"
                Grid.Row="0"
                Grid.Column="0"
                MinHeight="96"
                HorizontalAlignment="Stretch"
                Click="RegionCaptureButton_Click"
                AutomationProperties.Name="Region capture, Ctrl Shift 1">
              <Grid Width="Auto" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                  <TextBlock Text="Region" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Freeze the display, drag a precise area, resize, then save." Opacity="0.68" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Top" Padding="8,4" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <TextBlock Text="Ctrl+Shift+1" FontSize="11" Opacity="0.82" />
                </Border>
              </Grid>
            </Button>

            <Button Grid.Row="0" Grid.Column="1" MinHeight="96" HorizontalAlignment="Stretch" IsEnabled="False" AutomationProperties.Name="Window capture coming after version 0.0.1">
              <StackPanel Spacing="5">
                <TextBlock Text="Window" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Smart window targeting is scheduled after the first release." Opacity="0.68" TextWrapping="Wrap" />
                <TextBlock Text="Coming after 0.0.1" FontSize="11" Opacity="0.58" />
              </StackPanel>
            </Button>

            <Button
                x:Name="ScreenCaptureButton"
                Grid.Row="1"
                Grid.Column="0"
                MinHeight="96"
                HorizontalAlignment="Stretch"
                Click="ScreenCaptureButton_Click"
                AutomationProperties.Name="Screen capture, Ctrl Shift 4">
              <Grid Width="Auto" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                  <TextBlock Text="Screen" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Capture the primary display and save a PNG to Pictures\\SNAPVERE." Opacity="0.68" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Top" Padding="8,4" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <TextBlock Text="Ctrl+Shift+4" FontSize="11" Opacity="0.82" />
                </Border>
              </Grid>
            </Button>

            <Button Grid.Row="1" Grid.Column="1" MinHeight="96" HorizontalAlignment="Stretch" IsEnabled="False" AutomationProperties.Name="Scrolling capture coming after version 0.0.1">
              <StackPanel Spacing="5">
                <TextBlock Text="Scrolling" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Long-page stitching remains disabled until capture and seam quality are production-ready." Opacity="0.68" TextWrapping="Wrap" />
                <TextBlock Text="Coming after 0.0.1" FontSize="11" Opacity="0.58" />
              </StackPanel>
            </Button>
          </Grid>

          <StackPanel Grid.Row="3" Margin="0,34,0,0" Spacing="10">
            <Grid>
              <StackPanel Spacing="2">
                <TextBlock Text="Recent captures" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Newest local PNG files from Pictures\\SNAPVERE." FontSize="12" Opacity="0.62" />
              </StackPanel>
              <Button
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Content="Refresh"
                  Click="RefreshHistoryButton_Click"
                  AutomationProperties.Name="Refresh recent captures" />
            </Grid>

            <ListView
                x:Name="RecentCapturesList"
                SelectionMode="None"
                MaxHeight="320"
                Visibility="Collapsed">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Padding="4,10" MinWidth="420">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="38"
                        Height="38"
                        CornerRadius="9"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                      <SymbolIcon Symbol="Pictures" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding MetadataText}" Opacity="0.68" FontSize="12" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="HistoryEmptyState"
                Padding="24"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <StackPanel HorizontalAlignment="Center" Spacing="8">
                <TextBlock x:Name="HistoryEmptyTitle" Text="No local captures yet." FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="HistoryEmptyMessage" Text="Completed Screen and Region captures will appear here after they are saved locally." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.68" MaxWidth="480" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border
              Grid.Row="4"
              Margin="0,28,0,0"
              Padding="14,10"
              CornerRadius="10"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock
                Text="Private by default · no account · no telemetry · captures stay on this PC"
                FontSize="12"
                Opacity="0.70"
                HorizontalAlignment="Center" />
          </Border>
        </Grid>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Window>
