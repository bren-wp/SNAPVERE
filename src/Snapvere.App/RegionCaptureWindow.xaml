<Window
    x:Class="Snapvere.App.RegionCaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SNAPVERE — Region Capture">
  <Grid
      x:Name="OverlayRoot"
      Background="Black"
      KeyDown="OverlayRoot_KeyDown"
      KeyUp="OverlayRoot_KeyUp">
    <Image
        x:Name="FrozenImage"
        Stretch="Fill"
        IsHitTestVisible="False" />

    <Canvas
        x:Name="OverlayCanvas"
        Background="Transparent"
        PointerPressed="OverlayCanvas_PointerPressed"
        PointerMoved="OverlayCanvas_PointerMoved"
        PointerReleased="OverlayCanvas_PointerReleased"
        PointerCaptureLost="OverlayCanvas_PointerCaptureLost"
        DoubleTapped="OverlayCanvas_DoubleTapped">
      <Rectangle x:Name="FullDim" Fill="#99000000" IsHitTestVisible="False" />
      <Rectangle x:Name="TopDim" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
      <Rectangle x:Name="LeftDim" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
      <Rectangle x:Name="RightDim" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
      <Rectangle x:Name="BottomDim" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />

      <Border
          x:Name="SelectionBorder"
          BorderBrush="#FF0A84FF"
          BorderThickness="2"
          CornerRadius="2"
          IsHitTestVisible="False"
          Visibility="Collapsed" />

      <Border
          x:Name="SelectionBadge"
          Background="#E6212121"
          CornerRadius="6"
          Padding="8,4"
          IsHitTestVisible="False"
          Visibility="Collapsed">
        <TextBlock
            x:Name="SelectionSizeText"
            Foreground="White"
            FontSize="12"
            FontWeight="SemiBold" />
      </Border>

      <Ellipse x:Name="TopLeftHandle" Tag="TopLeft" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize top left" />
      <Ellipse x:Name="TopHandle" Tag="Top" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize top" />
      <Ellipse x:Name="TopRightHandle" Tag="TopRight" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize top right" />
      <Ellipse x:Name="RightHandle" Tag="Right" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize right" />
      <Ellipse x:Name="BottomRightHandle" Tag="BottomRight" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize bottom right" />
      <Ellipse x:Name="BottomHandle" Tag="Bottom" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize bottom" />
      <Ellipse x:Name="BottomLeftHandle" Tag="BottomLeft" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize bottom left" />
      <Ellipse x:Name="LeftHandle" Tag="Left" Width="10" Height="10" Fill="White" Stroke="#FF0A84FF" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize left" />
    </Canvas>

    <Border
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="20"
        Padding="14,9"
        Background="#E6212121"
        CornerRadius="8"
        IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Drag to select" Foreground="White" FontWeight="SemiBold" />
        <TextBlock Text="Enter save · Esc cancel · Arrows nudge · Shift+Arrows 10 px" Foreground="#DFFFFFFF" />
      </StackPanel>
    </Border>

    <Border
        x:Name="OverlayStatus"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="20"
        Padding="14,9"
        Background="#E6212121"
        CornerRadius="8"
        Visibility="Collapsed"
        IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ProgressRing x:Name="SaveProgress" Width="18" Height="18" IsActive="False" />
        <TextBlock x:Name="OverlayStatusText" Foreground="White" TextWrapping="Wrap" MaxWidth="620" />
      </StackPanel>
    </Border>

    <Button
        x:Name="KeyboardFocusTarget"
        Width="1"
        Height="1"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Opacity="0"
        IsTabStop="True"
        AutomationProperties.Name="Region capture keyboard input" />
  </Grid>
</Window>
