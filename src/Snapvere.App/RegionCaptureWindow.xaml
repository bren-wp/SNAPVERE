<Window
    x:Class="Snapvere.App.RegionCaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SNAPVERE — Region Capture">
  <Grid
      x:Name="OverlayRoot"
      Background="Black"
      KeyDown="OverlayRoot_KeyDown"
      KeyUp="OverlayRoot_KeyUp">
    <Image
        x:Name="FrozenImage"
        Stretch="Fill"
        IsHitTestVisible="False" />

    <Canvas
        x:Name="OverlayCanvas"
        Background="Transparent"
        PointerPressed="OverlayCanvas_PointerPressed"
        PointerMoved="OverlayCanvas_PointerMoved"
        PointerReleased="OverlayCanvas_PointerReleased"
        PointerCaptureLost="OverlayCanvas_PointerCaptureLost"
        DoubleTapped="OverlayCanvas_DoubleTapped">
      <Rectangle x:Name="FullDim" Fill="#A0000000" IsHitTestVisible="False" />
      <Rectangle x:Name="TopDim" Fill="#A0000000" IsHitTestVisible="False" Visibility="Collapsed" />
      <Rectangle x:Name="LeftDim" Fill="#A0000000" IsHitTestVisible="False" Visibility="Collapsed" />
      <Rectangle x:Name="RightDim" Fill="#A0000000" IsHitTestVisible="False" Visibility="Collapsed" />
      <Rectangle x:Name="BottomDim" Fill="#A0000000" IsHitTestVisible="False" Visibility="Collapsed" />

      <Border
          x:Name="SelectionBorder"
          BorderBrush="{ThemeResource SnapvereAccentBrush}"
          BorderThickness="2"
          CornerRadius="2"
          IsHitTestVisible="False"
          Visibility="Collapsed" />

      <Border
          x:Name="SelectionBadge"
          Background="#F015171C"
          BorderBrush="#40FFFFFF"
          BorderThickness="1"
          CornerRadius="7"
          Padding="9,5"
          IsHitTestVisible="False"
          Visibility="Collapsed">
        <TextBlock
            x:Name="SelectionSizeText"
            Foreground="White"
            FontSize="12"
            FontWeight="SemiBold" />
      </Border>

      <Ellipse x:Name="TopLeftHandle" Tag="TopLeft" Width="10" Height="10" Fill="White" Stroke="{ThemeResource SnapvereAccentBrush}" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize top left" />
      <Ellipse x:Name="TopHandle" Tag="Top" Width="10" Height="10" Fill="White" Stroke="{ThemeResource SnapvereAccentBrush}" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize top" />
      <Ellipse x:Name="TopRightHandle" Tag="TopRight" Width="10" Height="10" Fill="White" Stroke="{ThemeResource SnapvereAccentBrush}" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize top right" />
      <Ellipse x:Name="RightHandle" Tag="Right" Width="10" Height="10" Fill="White" Stroke="{ThemeResource SnapvereAccentBrush}" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize right" />
      <Ellipse x:Name="BottomRightHandle" Tag="BottomRight" Width="10" Height="10" Fill="White" Stroke="{ThemeResource SnapvereAccentBrush}" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize bottom right" />
      <Ellipse x:Name="BottomHandle" Tag="Bottom" Width="10" Height="10" Fill="White" Stroke="{ThemeResource SnapvereAccentBrush}" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize bottom" />
      <Ellipse x:Name="BottomLeftHandle" Tag="BottomLeft" Width="10" Height="10" Fill="White" Stroke="{ThemeResource SnapvereAccentBrush}" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize bottom left" />
      <Ellipse x:Name="LeftHandle" Tag="Left" Width="10" Height="10" Fill="White" Stroke="{ThemeResource SnapvereAccentBrush}" StrokeThickness="2" Visibility="Collapsed" PointerPressed="Handle_PointerPressed" AutomationProperties.Name="Resize left" />

      <Border
          x:Name="ToolPalette"
          Visibility="Collapsed"
          Background="#F5111318"
          BorderBrush="#45FFFFFF"
          BorderThickness="1"
          CornerRadius="10"
          Padding="5">
        <StackPanel Spacing="4">
          <Button x:Name="MoveToolButton" Tag="None" Content="Move" MinWidth="58" Click="AnnotationToolButton_Click" ToolTipService.ToolTip="Move or resize selection" />
          <Button x:Name="PenToolButton" Tag="Pen" Content="Pen" MinWidth="58" Click="AnnotationToolButton_Click" ToolTipService.ToolTip="Freehand pen" />
          <Button x:Name="LineToolButton" Tag="Line" Content="Line" MinWidth="58" Click="AnnotationToolButton_Click" ToolTipService.ToolTip="Straight line" />
          <Button x:Name="ArrowToolButton" Tag="Arrow" Content="Arrow" MinWidth="58" Click="AnnotationToolButton_Click" ToolTipService.ToolTip="Arrow" />
          <Button x:Name="RectangleToolButton" Tag="Rectangle" Content="Box" MinWidth="58" Click="AnnotationToolButton_Click" ToolTipService.ToolTip="Rectangle" />
          <Button x:Name="HighlightToolButton" Tag="Highlight" Content="Mark" MinWidth="58" Click="AnnotationToolButton_Click" ToolTipService.ToolTip="Highlighter" />
          <Rectangle Height="1" Fill="#35FFFFFF" Margin="4,2" />
          <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
            <Button Tag="Coral" Width="25" Height="25" Padding="0" Click="ColorButton_Click" ToolTipService.ToolTip="Coral">
              <Ellipse Width="13" Height="13" Fill="#FF5A72" />
            </Button>
            <Button Tag="Amber" Width="25" Height="25" Padding="0" Click="ColorButton_Click" ToolTipService.ToolTip="Amber">
              <Ellipse Width="13" Height="13" Fill="#FFC857" />
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
            <Button Tag="Mint" Width="25" Height="25" Padding="0" Click="ColorButton_Click" ToolTipService.ToolTip="Mint">
              <Ellipse Width="13" Height="13" Fill="#45D6A2" />
            </Button>
            <Button Tag="Indigo" Width="25" Height="25" Padding="0" Click="ColorButton_Click" ToolTipService.ToolTip="Indigo">
              <Ellipse Width="13" Height="13" Fill="#7C6CFF" />
            </Button>
          </StackPanel>
          <Rectangle Height="1" Fill="#35FFFFFF" Margin="4,2" />
          <Button x:Name="UndoButton" Content="Undo" MinWidth="58" Click="UndoButton_Click" ToolTipService.ToolTip="Undo last annotation" />
        </StackPanel>
      </Border>

      <Border
          x:Name="ActionPalette"
          Visibility="Collapsed"
          Background="#F5111318"
          BorderBrush="#45FFFFFF"
          BorderThickness="1"
          CornerRadius="10"
          Padding="5">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Button Content="Copy" Click="CopyButton_Click" ToolTipService.ToolTip="Copy selection to clipboard" />
          <Button Content="Save" Click="SaveButton_Click" ToolTipService.ToolTip="Save PNG" />
          <Button Content="Close" Click="CancelButton_Click" ToolTipService.ToolTip="Cancel capture" />
        </StackPanel>
      </Border>
    </Canvas>

    <Canvas
        x:Name="AnnotationLayer"
        IsHitTestVisible="False" />

    <Border
        x:Name="CaptureHint"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="16"
        Padding="12,8"
        Background="#E8111318"
        BorderBrush="#30FFFFFF"
        BorderThickness="1"
        CornerRadius="9"
        IsHitTestVisible="False">
      <TextBlock
          Text="Drag to select · choose a tool to annotate · Enter save · Esc cancel"
          Foreground="#E8FFFFFF"
          FontSize="12" />
    </Border>

    <Border
        x:Name="OverlayStatus"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="20"
        Padding="14,9"
        Background="#F015171C"
        BorderBrush="#38FFFFFF"
        BorderThickness="1"
        CornerRadius="9"
        Visibility="Collapsed"
        IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ProgressRing x:Name="SaveProgress" Width="18" Height="18" IsActive="False" />
        <TextBlock x:Name="OverlayStatusText" Foreground="White" TextWrapping="Wrap" MaxWidth="620" />
      </StackPanel>
    </Border>

    <Button
        x:Name="KeyboardFocusTarget"
        Width="1"
        Height="1"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Opacity="0"
        IsTabStop="True"
        AutomationProperties.Name="Region capture keyboard input" />
  </Grid>
</Window>
